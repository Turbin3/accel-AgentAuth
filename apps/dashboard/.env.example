# AgentAuth Mandate Studio - environment. Copy to .env.local. No secrets belong in this file.
# Everything here is read on the server at request time and handed to the browser through the root
# layout, so a changed value needs a restart, not a rebuild.

# localnet | devnet. "mainnet-beta" is refused: AgentAuth has no mainnet deployment.
NEXT_PUBLIC_AA_CLUSTER=devnet

# RPC endpoint. Defaults: localnet http://127.0.0.1:8899, devnet https://api.devnet.solana.com.
# For a local validator started with `scripts/localnet.sh`, run `eval "$(scripts/localnet.sh env)"`
# first: AA_RPC_URL / AA_WS_URL / AA_DEMO_DIR are picked up as fallbacks.
# NEXT_PUBLIC_AA_RPC_URL=http://127.0.0.1:8899

# Optional: a mandate address shown (read-only) to visitors who have not connected a wallet.
# NEXT_PUBLIC_AA_DEMO_MANDATE=

# Optional: Phantom Connect app id from https://phantom.com/portal. Enables Google / Apple login.
# Without it, only the Phantom browser extension and Wallet Standard wallets can connect.
# NEXT_PUBLIC_PHANTOM_APP_ID=

# DEV SIGNER (localnet and devnet only; impossible on mainnet). 1 = offer a throwaway browser key
# (sessionStorage, banner shown). On localnet it also offers the "demo owner" key read server-side
# from AA_DEV_KEYPAIR_PATH (a Solana CLI keypair file) or, if unset, from $AA_DEMO_DIR/keys/owner.json.
# NEXT_PUBLIC_AA_DEV_SIGNER=1
# AA_DEV_KEYPAIR_PATH=

# Simulator ("Try to break it"): needs the localnet demo bootstrap
# (`pnpm --filter @agentauth-sol/demo bootstrap`), which writes $AA_DEMO_DIR (default <repo>/.demo).
# AA_DEMO_DIR=

# Optional: public source repository shown in the footer and on the landing page (https only).
# NEXT_PUBLIC_AA_REPO_URL=
