{
  "name": "@agentauth-sol/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "AgentAuth Mandate Studio: Next.js dashboard for creating, reviewing and revoking agent mandates (unaudited devnet prototype)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "screens": "playwright test --config playwright.screens.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.mjs\""
  },
  "dependencies": {
    "@agentauth-sol/demo": "workspace:*",
    "@agentauth-sol/registry": "workspace:*",
    "@agentauth-sol/sdk": "workspace:*",
    "@phantom/react-sdk": "2.0.4",
    "@solana/kit": "8.4.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
