{
  "name": "agentauth-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "AgentAuth: on-chain mandates for AI agents on Solana (monorepo root)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "localnet": "scripts/localnet.sh",
    "bootstrap": "pnpm --filter @agentauth-sol/demo bootstrap",
    "demo:contrast": "pnpm --filter @agentauth-sol/demo contrast",
    "demo:scenario": "pnpm --filter @agentauth-sol/demo scenario",
    "demo:attacks": "pnpm --filter @agentauth-sol/demo attacks"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
